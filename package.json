{
  "name": "grok-build-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Grok Build 桌面端：通过 ACP 调用本机 grok CLI 的 Electron 界面",
  "author": "Grok Build Desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5174 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --format=cjs --sourcemap",
    "build": "vite build && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "esbuild tests/plan-flow.test.ts --bundle --platform=node --format=cjs --outfile=.test-dist/plan-flow.test.cjs && node --test .test-dist/plan-flow.test.cjs",
    "start": "electron .",
    "pack:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "release:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "ai.x.grok.build.desktop",
    "productName": "Grok Build",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon-rounded.ico",
      "build/icon-rounded.png",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "stripling-feng",
        "repo": "grok-build-desktop"
      }
    ],
    "win": {
      "icon": "build/icon-rounded.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Grok Build"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.3",
    "resedit": "^3.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "wait-on": "^8.0.3"
  }
}
